{"html":"<div>\n            <div x-data=\"{ selected: false, open: true }\" \n        x-on:clear-selection.window=\"selected = false\"\n        class=\"flex flex-col sm:flex-row gap-4 p-4 mt-4 shadow-md bg-background border-2 rounded-xl border-gray-200\">\n        <div class=\"flex\">\n            <button x-on:click=\"selected = !selected; $dispatch('select-procurement', { id: 832217 })\"\n                x-on:select-all.window=\"selected = true; $dispatch('select-procurement', { id: 832217, all: true })\"\n                x-bind:class=\"selected ? 'bg-primary' : 'bg-white'\"\n                class=\"relative w-6 h-6 aspect-square rounded-md border-2 border-gray-200 hover:border-blue-300 duration-100 transition-colors\">\n                <i  x-show=\"selected\" \n                    class=\"absolute top-1\/2 left-1\/2 transform -translate-x-1\/2 -translate-y-1\/2 fa-solid fa-check text-white\"><\/i>\n            <\/button>\n            <button class=\"flex-grow flex justify-end md:hidden\" x-on:click=\"open = !open\" type=\"button\">\n                <i class=\"fa-solid fa-chevron-down\" x-show=\"open\"><\/i>\n                <i class=\"fa-solid fa-chevron-up\" x-show=\"!open\"><\/
