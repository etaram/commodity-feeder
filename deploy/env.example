# Copy to deploy/.env ON THE SERVER and fill in there. Never commit .env, never paste these values into a chat.
# The names are the same ones the app uses on Vercel (Project > Settings > Environment Variables).
DESK_DOMAIN=desk.sinder.pro
POSTGRES_PASSWORD=            # install.sh generates one

# sign-in and sessions
AUTH_SECRET=                  # keep the SAME value as on Vercel, or every user is signed out and the MCP address changes
TEAM_USER=
TEAM_PASSCODE=
CRON_SECRET=                  # any long random string (install.sh generates one)

# data
WEB_INDEX_KEY=                # the same key the data workflows use (GitHub secret WEB_INDEX_KEY / Config sheet)
GOOGLE_SERVICE_ACCOUNT_JSON=  # one line of JSON
STATE_SHEET_ID=1LrpaLYWZp3OJfMF8aNtNQM6JByy4QpQU-PAKuE_VVVo

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Telegram bot (the variable on Vercel is named sinder_desk_bot)
sinder_desk_bot=
TELEGRAM_WEBHOOK_SECRET=

# mail
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
RESEND_API_KEY=

# web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
